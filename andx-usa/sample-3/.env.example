
# PAPER (quotes only) needs just ANDX_USER_NAME + ANDX_TOKEN.
# LIVE (real orders + fill status) needs all five ANDX_* vars.

# --- ANDX credentials (never commit real values) ---
export ANDX_USER_NAME=your_user_name
export ANDX_TOKEN=your_instant_trade_token
export ANDX_API_KEY=your_api_key
export ANDX_API_SECRET=your_api_secret
export ANDX_PASSPHRASE=your_api_passphrase

# --- runtime (optional; these override the CONFIG dict in the script) ---
# export DRY_RUN=0            # 0 = LIVE real orders; unset or 1 = paper (default)
# export INITIAL_CASH=35      # USDT the bot tracks internally

